# Port the whiteboard server runs on (default 5000)
PORT=5000

# MongoDB connection string — create a free Atlas cluster (or use a local MongoDB)
# and replace the placeholders. If MONGO_URI is unreachable the app automatically
# falls back to local MongoDB, then to in-memory mode.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/whiteboard_socket?retryWrites=true&w=majority